#!/usr/bin/env bash
# Mirror omp's declarative config into a git repo. Allowlist in, secrets out.
set -euo pipefail

REPO="${OMP_CONFIG_REPO:-$HOME/omp-config}"
PUSH=0
YES=0
for arg in "$@"; do
	case "$arg" in
	--push) PUSH=1 ;;
	--yes) YES=1 ;;
	--repo=*) REPO="${arg#--repo=}" ;;
	*) echo "usage: omp-config-sync [--push] [--yes] [--repo=PATH]" >&2; exit 2 ;;
	esac
done

profile="${OMP_PROFILE:-${PI_PROFILE:-}}"
if [ -n "$profile" ] && [ "$profile" != "default" ]; then
	AGENT_DIR="$HOME/.omp/profiles/$profile/agent"
else
	AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}"
fi

[ -d "$AGENT_DIR" ] || { echo "agent dir not found: $AGENT_DIR" >&2; exit 1; }

# Allowlist: files copied verbatim (sanitized first), directories copied wholesale.
FILES=(config.yml config.yaml models.yml keybindings.json keybindings.yml keybindings.yaml
	RULES.md SYSTEM.md SYSTEM_TEMPLATE.md APPEND_SYSTEM.md TITLE_SYSTEM.md quota-status.json)
DIRS=(pack skills extensions tools commands rules prompts instructions hooks)

STAGE="$REPO/agent"
NOTES="$REPO/RESTORE.md"
STRIPPED="$STAGE/.sanitized.txt"

fail() { echo "GATE FAILED: $*" >&2; exit 1; }

mkdir -p "$STAGE"

# ---------------------------------------------------------------- copy
# config.yml and models.yml are handled below: their sensitive values are stripped
# *during* the copy, so an unsanitized copy never exists under the repo at all —
# not even in the window between copying and sanitizing.
for f in "${FILES[@]}"; do
	case "$f" in config.yml | models.yml) continue ;; esac
	[ -f "$AGENT_DIR/$f" ] && cp -p "$AGENT_DIR/$f" "$STAGE/$f"
done
for d in "${DIRS[@]}"; do
	[ -d "$AGENT_DIR/$d" ] || continue
	rm -rf "${STAGE:?}/$d"
	cp -r "$AGENT_DIR/$d" "$STAGE/$d"
done
[ -f "$AGENT_DIR/.mcp.json" ] && cp -p "$AGENT_DIR/.mcp.json" "$STAGE/.mcp.json"

# ---------------------------------------------------------------- sanitize
: > "$STRIPPED.new"
strip() { # file what
	printf '%s: %s removed (literal value) — supply it from the environment on restore\n' "$1" "$2" >> "$STRIPPED.new"
}

# Strip on the way in: sed reads the live file and writes only the sanitized
# result, so the raw value is never written under the repo, not even briefly.
if [ -f "$AGENT_DIR/models.yml" ]; then
	n=$(grep -cE '^[[:space:]]*apiKey:[[:space:]]*["'\'']?[^"'\''[:space:]]' "$AGENT_DIR/models.yml" || true)
	if [ "${n:-0}" -gt 0 ]; then
		strip models.yml "$n literal apiKey value(s)"
		sed -E 's|^([[:space:]]*apiKey:[[:space:]]*).*$|# \1# REMOVED by omp-config-sync — set from the environment|' \
			"$AGENT_DIR/models.yml" > "$STAGE/models.yml"
	else
		cp -p "$AGENT_DIR/models.yml" "$STAGE/models.yml"
	fi
fi

if [ -f "$AGENT_DIR/config.yml" ]; then
	if grep -qE '^[[:space:]]*token:[[:space:]]*\S' "$AGENT_DIR/config.yml"; then
		strip config.yml 'broker token'
		sed -E 's|^([[:space:]]*token:[[:space:]]*).*$|\1# REMOVED by omp-config-sync — set auth.broker.token from the environment|' \
			"$AGENT_DIR/config.yml" > "$STAGE/config.yml"
	else
		cp -p "$AGENT_DIR/config.yml" "$STAGE/config.yml"
	fi
fi

# Home paths leak a username into a public repo; normalize them.
# `/$HOME/` would expand to `//home/user/` — a double slash that matches nothing —
# so match the home prefix as a fixed string instead. The `|| true` is load-bearing:
# grep exits 1 when it matches nothing, which under `set -euo pipefail` would abort
# the entire sync on a tree that simply has no absolute home paths.
grep -rlF "$HOME/" "$STAGE" 2>/dev/null | while IFS= read -r f; do
	sed -i "s|$HOME/|~/|g" "$f"
	echo "  normalized ~ paths in ${f#$REPO/}"
done || true

[ -s "$STRIPPED.new" ] && mv "$STRIPPED.new" "$STRIPPED" || { rm -f "$STRIPPED.new"; : > "$STRIPPED"; }

# ---------------------------------------------------------------- gates
echo "gate 1/5: token-shaped literals anywhere"
HITS=$(grep -rInE '(sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})' \
	"$STAGE" --exclude-dir=.git || true)
[ -z "$HITS" ] || { echo "$HITS" >&2; fail "token-shaped literal present (above)"; }

echo "gate 2/5: credential-shaped values in config files"
# Scoped to config-shaped files on purpose: in source code `authorization = token…`
# is ordinary TypeScript, and flagging it makes the gate cry wolf.
CONF=$(find "$STAGE" -type f \( -name '*.yml' -o -name '*.yaml' -o -name '*.json' -o -name '*.jsonc' \
	-o -name '*.toml' -o -name '.mcp.json' -o -name '.env*' \) -not -path '*/.git/*' || true)
# `-i` is load-bearing: config keys are camelCase (apiKey) as often as snake_case
# (api_key), and a case-sensitive gate silently misses half of them.
HITS=$(printf '%s' "$CONF" | xargs -r grep -HinE '(api[_-]?key|token|secret|password|passwd|authorization)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9_./+-]{8,}' 2>/dev/null | grep -vi 'env:' || true)
[ -z "$HITS" ] || { echo "$HITS" >&2; fail "credential-shaped value in a config file (above)"; }

echo "gate 3/5: private keys and ssh material"
KEYS=$(grep -rlE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|ssh-(rsa|ed25519) AAAA' "$STAGE" 2>/dev/null || true)
[ -z "$KEYS" ] || { echo "$KEYS" >&2; fail "private key material present"; }

echo "gate 4/5: trufflehog"
if command -v trufflehog >/dev/null 2>&1; then
	TH=$(trufflehog filesystem "$STAGE" --no-update --results=verified,unknown 2>/dev/null | grep -c '^Finding:' || true)
	[ "${TH:-0}" -eq 0 ] || fail "trufflehog reported ${TH} finding(s)"
	echo "  trufflehog clean"
else
	echo "  trufflehog not installed — skipped (install it: https://github.com/trufflesecurity/trufflehog)"
fi

echo "gate 5/5: credential literals in source (advisory)"
# Advisory, not blocking: it needs a *quoted* literal, so `token = token.stdout…`
# stays quiet, but a hardcoded key in a hook or extension gets surfaced in the
# diff review rather than silently committed.
SRC=$(find "$STAGE" -type f \( -name '*.ts' -o -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \) -not -path '*/.git/*' || true)
# `-i` matters here for the same reason as gate 2: `apiKey` is camelCase.
REVIEW=$(printf '%s' "$SRC" | xargs -r grep -HinE '(api[_-]?key|token|secret|password|passwd|authorization)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{12,}["'\'']' 2>/dev/null || true)
if [ -n "$REVIEW" ]; then
	echo "  REVIEW before pushing — quoted credential-looking literal in source:"
	printf '%s\n' "$REVIEW" | sed 's/^/    /'
fi

# ---------------------------------------------------------------- pin versions
{
	echo "# Pinned by omp-config-sync on $(date -u +%Y-%m-%dT%H:%M:%SZ). Used by omp-config-restore."
	echo "OMP_VERSION=$(omp --version 2>/dev/null | sed 's|^omp/||' || echo unknown)"
	echo "BUN_VERSION=$(bun --version 2>/dev/null || echo unknown)"
	echo "PROFILE=${profile:-default}"
} > "$REPO/versions.env"

cat > "$NOTES" <<'RESTORE_EOF'
# Restore notes

Generated by `omp-config-sync`. It contains no secret values — only names of
values that were stripped at backup time.

## Pinned versions

See [versions.env](versions.env). Restore installs whatever is pinned there.

## Steps on a new machine

Run `agent/skills/omp-config/bin/omp-config-restore` from this repo. It installs
bun and omp if missing, then copies `agent/` into the active omp agent dir.

Then, per provider: `/login <provider>` — or export the environment variables
listed in `agent/.sanitized.txt`.
RESTORE_EOF

cat > "$REPO/README.md" <<'README_EOF'
# omp-config

Personal [omp](https://omp.sh) configuration, published so a new machine can be
bootstrapped from a single command.

**No secrets are stored here.** API keys, OAuth tokens and SSH keys live only on
the machine that holds them. See [RESTORE.md](RESTORE.md) for what was stripped.

## What is in here

| Path | Contents |
| --- | --- |
| `agent/config.yml` | model roles, theme, composer, and every other setting |
| `agent/pack/` | the custom extension package referenced from `config.yml` |
| `agent/skills/` | user-level skills |
| `agent/extensions/` | loose extension modules |
| `agent/{tools,commands,rules,prompts,hooks,instructions}/` | the rest of the capability surface |
| `versions.env` | pinned `omp` and `bun` versions, written at each backup |
| `agent/.sanitized.txt` | which values were removed at backup time |
| `agent/skills/omp-config/bin/` | the backup and restore scripts |

## What is deliberately absent

`agent.db` (holds OAuth tokens and API keys), every other database, `sessions/`,
`blobs/`, `cache/`, `secrets.yml`, and the per-install identity. Those are
machine state, not configuration.

## Restoring on a new machine

Needs only bash and curl:

    curl -fsSL __REPO_BASE__/raw/HEAD/agent/skills/omp-config/bin/omp-config-restore \
      | bash -s -- --repo=__REPO_CLONE__

The script installs bun if missing, installs the pinned omp version if it is
missing or off-pin, copies `agent/` into the active omp agent directory, then
prints the `/login` steps. Credentials are never restored from this repo.

Flags: `--dry-run`, `--target=DIR` (restore into a scratch directory),
`--repo=PATH|URL`, `--force` (overwrite existing files, keeping `.bak-<ts>`).

## Updating this repo

Sync runs on demand, never on a timer:

    agent/skills/omp-config/bin/omp-config-sync            # copy, sanitize, gate, diff, commit
    agent/skills/omp-config/bin/omp-config-sync --push     # commit, then push after confirming

The sync copies an allowlist out of the omp agent directory, strips literal
`apiKey:` and broker-token values, and normalizes absolute home paths to `~/`.

It then runs five gates while staging, and a final sweep against the **staged
index** — so what is audited is literally what would be committed: token-shaped
literals and private keys block the commit, credential-shaped values raise an
advisory review, and `trufflehog` scans an export of the index. `trufflehog` is
mandatory before `--push`. Nothing is committed without a diff review either.

## Authoring extensions

The extension package and its house rules are documented in
[`agent/skills/omp-extensions/SKILL.md`](agent/skills/omp-extensions/SKILL.md).
README_EOF

REMOTE=$(git -C "$REPO" remote get-url origin 2>/dev/null || echo "")
# Strip inline credentials before the URL is written into a public file:
# https://user:token@host/… would otherwise be committed verbatim.
SAFE_REMOTE=$(printf '%s' "$REMOTE" | sed -E 's|^(https?://)[^/@]+@|\1|')
# An ssh remote cannot be curled; derive the browsable https base from it.
BASE=$(printf '%s' "$SAFE_REMOTE" | sed -E 's|^git@([^:]+):(.+)\.git$|https://\1/\2|; s|^ssh://git@([^/]+)/(.+)\.git$|https://\1/\2|; s|^https?://(.+)\.git$|https://\1|')
if [ -n "$BASE" ]; then
	sed -i "s|__REPO_BASE__|$BASE|g" "$REPO/README.md"
	sed -i "s|__REPO_CLONE__|$SAFE_REMOTE|g" "$REPO/README.md"
fi

# ---------------------------------------------------------------- stage
cd "$REPO"
git init -q 2>/dev/null || true
# Merge rather than create: an existing .gitignore must gain the patterns too.
touch .gitignore
for pat in '*.bak-*' '.DS_Store' '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' \
	'id_rsa*' 'id_ed25519*' 'auth.json' 'secrets.yml'; do
	grep -qxF "$pat" .gitignore || printf '%s\n' "$pat" >> .gitignore
done
git add -A

# ---------------------------------------------------------------- index sweep
# Audited against the staged index, not the working tree: what is checked is
# literally what would be committed. Consequences, both intended — an ignored
# local .env can no longer block a sync, and there is no window between the scan
# and the staging it was supposed to describe.
echo "index sweep: staged snapshot ($(git diff --cached --name-only | wc -l) file(s))"
FINAL=$(git grep --cached -nI -E '(sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})' -- . || true)
[ -z "$FINAL" ] || { echo "$FINAL" >&2; fail "token-shaped literal in the staged snapshot (above)"; }
KEYS=$(git grep --cached -lI -E -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|ssh-(rsa|ed25519) AAAA' -- . || true)
[ -z "$KEYS" ] || { echo "$KEYS" >&2; fail "private key material in the staged snapshot"; }

# Advisory across every staged file. The value class deliberately excludes `.`
# and demands 12+ characters: that separates a bare secret (`password=hunter2…`)
# from ordinary code (`const apiKey = token.stdout.trim()`), which is property
# access. It stays advisory so a false positive never blocks a backup.
REVIEW=$(git grep --cached -nI -iE '(api[_-]?key|token|secret|password|passwd|authorization)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9_/+-]{12,}' -- . || true)
if [ -n "$REVIEW" ]; then
	echo "  REVIEW before committing — credential-shaped value in a staged file:"
	printf '%s\n' "$REVIEW" | sed 's/^/    /'
fi

if command -v trufflehog >/dev/null 2>&1; then
	IDX=$(mktemp -d)
	git checkout-index -a -f --prefix="$IDX/" 2>/dev/null || true
	TH=$(trufflehog filesystem "$IDX" --no-update --results=verified,unknown 2>/dev/null | grep -c '^Finding:' || true)
	rm -rf "$IDX"
	[ "${TH:-0}" -eq 0 ] || fail "trufflehog reported ${TH} finding(s) in the staged snapshot"
	echo "  trufflehog clean (staged snapshot)"
else
	[ "$PUSH" -eq 1 ] && fail "trufflehog is not installed; it is required before --push"
	echo "  trufflehog not installed — index sweep skipped (required for --push)"
fi
echo
git diff --cached --stat | tail -20
if [ "$YES" -ne 1 ]; then
	read -r -p "commit these? [y/N] " ans
	[ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "aborted"; exit 0; }
fi
git commit -q -m "omp config sync $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "committed: $(git rev-parse --short HEAD)"

if [ "$PUSH" -eq 1 ]; then
	read -r -p "push to $(git remote get-url origin 2>/dev/null || echo '<no origin>')? [y/N] " ans
	[ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "committed, not pushed"; exit 0; }
	git push -q origin HEAD
	echo "pushed"
fi