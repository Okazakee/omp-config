#!/usr/bin/env bash
# Mirror omp's declarative config into a git repo. Allowlist in, secrets out.
set -euo pipefail

REPO="${OMP_CONFIG_REPO:-$HOME/omp-config}"
PUSH=0
YES=0
for arg in "$@"; do
	case "$arg" in
	--push) PUSH=1 ;;
	--yes) YES=1 ;;
	--repo=*) REPO="${arg#--repo=}" ;;
	*) echo "usage: omp-config-sync [--push] [--yes] [--repo=PATH]" >&2; exit 2 ;;
	esac
done

profile="${OMP_PROFILE:-${PI_PROFILE:-}}"
if [ -n "$profile" ] && [ "$profile" != "default" ]; then
	AGENT_DIR="$HOME/.omp/profiles/$profile/agent"
else
	AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}"
fi

[ -d "$AGENT_DIR" ] || { echo "agent dir not found: $AGENT_DIR" >&2; exit 1; }

# Allowlist: files copied verbatim (sanitized first), directories copied wholesale.
FILES=(config.yml config.yaml models.yml keybindings.json keybindings.yml keybindings.yaml
	RULES.md SYSTEM.md SYSTEM_TEMPLATE.md APPEND_SYSTEM.md TITLE_SYSTEM.md)
DIRS=(pack skills extensions tools commands rules prompts instructions hooks)

STAGE="$REPO/agent"
NOTES="$REPO/RESTORE.md"
STRIPPED="$STAGE/.sanitized.txt"

fail() { echo "GATE FAILED: $*" >&2; exit 1; }

mkdir -p "$STAGE"

# ---------------------------------------------------------------- copy
for f in "${FILES[@]}"; do
	[ -f "$AGENT_DIR/$f" ] && cp -p "$AGENT_DIR/$f" "$STAGE/$f"
done
for d in "${DIRS[@]}"; do
	[ -d "$AGENT_DIR/$d" ] || continue
	rm -rf "${STAGE:?}/$d"
	cp -r "$AGENT_DIR/$d" "$STAGE/$d"
done
[ -f "$AGENT_DIR/.mcp.json" ] && cp -p "$AGENT_DIR/.mcp.json" "$STAGE/.mcp.json"

# ---------------------------------------------------------------- sanitize
: > "$STRIPPED.new"
strip() { # file what
	printf '%s: %s removed (literal value) — supply it from the environment on restore\n' "$1" "$2" >> "$STRIPPED.new"
}

if [ -f "$STAGE/models.yml" ] && grep -qE '^[[:space:]]*apiKey:[[:space:]]*["'\'']?[^"'\''[:space:]]' "$STAGE/models.yml"; then
	n=$(grep -cE '^[[:space:]]*apiKey:[[:space:]]*["'\'']?[^"'\''[:space:]]' "$STAGE/models.yml")
	strip models.yml "$n literal apiKey value(s)"
	sed -i -E 's|^([[:space:]]*apiKey:[[:space:]]*).*$|# \1# REMOVED by omp-config-sync — set from the environment|' "$STAGE/models.yml"
fi

if [ -f "$STAGE/config.yml" ]; then
	if grep -qE '^[[:space:]]*token:[[:space:]]*\S' "$STAGE/config.yml"; then
		strip config.yml 'broker token'
		sed -i -E 's|^([[:space:]]*token:[[:space:]]*).*$|\1# REMOVED by omp-config-sync — set auth.broker.token from the environment|' "$STAGE/config.yml"
	fi
fi

# Home paths leak a username into a public repo; normalize them.
if grep -rl "/$HOME/" "$STAGE" >/dev/null 2>&1; then
	grep -rl "/$HOME/" "$STAGE" | while IFS= read -r f; do
		sed -i "s|/$HOME/|~/|g" "$f"
		echo "  normalized ~ paths in ${f#$REPO/}"
	done
fi

[ -s "$STRIPPED.new" ] && mv "$STRIPPED.new" "$STRIPPED" || { rm -f "$STRIPPED.new"; : > "$STRIPPED"; }

# ---------------------------------------------------------------- gates
echo "gate 1/4: token-shaped literals anywhere"
HITS=$(grep -rInE '(sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})' \
	"$STAGE" --exclude-dir=.git || true)
[ -z "$HITS" ] || { echo "$HITS" >&2; fail "token-shaped literal present (above)"; }

echo "gate 2/4: credential-shaped values in config files"
# Scoped to config-shaped files on purpose: in source code `authorization = token…`
# is ordinary TypeScript, and flagging it makes the gate cry wolf.
CONF=$(find "$STAGE" -type f \( -name '*.yml' -o -name '*.yaml' -o -name '*.json' -o -name '*.jsonc' \
	-o -name '*.toml' -o -name '.mcp.json' -o -name '.env*' \) -not -path '*/.git/*' || true)
HITS=$(printf '%s' "$CONF" | xargs -r grep -InE '(api[_-]?key|token|secret|password|passwd|authorization)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9_./+-]{8,}' 2>/dev/null | grep -v 'env:' || true)
[ -z "$HITS" ] || { echo "$HITS" >&2; fail "credential-shaped value in a config file (above)"; }

echo "gate 3/4: private keys and ssh material"
KEYS=$(grep -rlE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|ssh-(rsa|ed25519) AAAA' "$STAGE" 2>/dev/null || true)
[ -z "$KEYS" ] || { echo "$KEYS" >&2; fail "private key material present"; }

echo "gate 4/4: trufflehog"
if command -v trufflehog >/dev/null 2>&1; then
	TH=$(trufflehog filesystem "$STAGE" --no-update --results=verified,unknown 2>/dev/null | grep -c '^Finding:' || true)
	[ "${TH:-0}" -eq 0 ] || fail "trufflehog reported ${TH} finding(s)"
	echo "  trufflehog clean"
else
	echo "  trufflehog not installed — skipped (install it: https://github.com/trufflesecurity/trufflehog)"
fi

# ---------------------------------------------------------------- pin versions
{
	echo "# Pinned by omp-config-sync on $(date -u +%Y-%m-%dT%H:%M:%SZ). Used by omp-config-restore."
	echo "OMP_VERSION=$(omp --version 2>/dev/null | sed 's|^omp/||' || echo unknown)"
	echo "BUN_VERSION=$(bun --version 2>/dev/null || echo unknown)"
	echo "PROFILE=${profile:-default}"
} > "$REPO/versions.env"

cat > "$NOTES" <<'RESTORE_EOF'
# Restore notes

Generated by `omp-config-sync`. It contains no secret values — only names of
values that were stripped at backup time.

## Pinned versions

See [versions.env](versions.env). Restore installs whatever is pinned there.

## Steps on a new machine

Run `agent/skills/omp-config/bin/omp-config-restore` from this repo. It installs
bun and omp if missing, then copies `agent/` into the active omp agent dir.

Then, per provider: `/login <provider>` — or export the environment variables
listed in `agent/.sanitized.txt`.
RESTORE_EOF

cat > "$REPO/README.md" <<'README_EOF'
# omp-config

Personal [omp](https://omp.sh) configuration, published so a new machine can be
bootstrapped from a single command.

**No secrets are stored here.** API keys, OAuth tokens and SSH keys live only on
the machine that holds them. See [RESTORE.md](RESTORE.md) for what was stripped.

## What is in here

| Path | Contents |
| --- | --- |
| `agent/config.yml` | model roles, theme, composer, and every other setting |
| `agent/pack/` | the custom extension package referenced from `config.yml` |
| `agent/skills/` | user-level skills |
| `agent/extensions/` | loose extension modules |
| `agent/{tools,commands,rules,prompts,hooks,instructions}/` | the rest of the capability surface |
| `versions.env` | pinned `omp` and `bun` versions, written at each backup |
| `agent/.sanitized.txt` | which values were removed at backup time |
| `agent/skills/omp-config/bin/` | the backup and restore scripts |

## What is deliberately absent

`agent.db` (holds OAuth tokens and API keys), every other database, `sessions/`,
`blobs/`, `cache/`, `secrets.yml`, and the per-install identity. Those are
machine state, not configuration.

## Restoring on a new machine

Needs only bash and curl:

    curl -fsSL __REPO_BASE__/raw/HEAD/agent/skills/omp-config/bin/omp-config-restore \
      | bash -s -- --repo=__REPO_CLONE__

The script installs bun if missing, installs the pinned omp version if it is
missing or off-pin, copies `agent/` into the active omp agent directory, then
prints the `/login` steps. Credentials are never restored from this repo.

Flags: `--dry-run`, `--target=DIR` (restore into a scratch directory),
`--repo=PATH|URL`, `--force` (overwrite existing files, keeping `.bak-<ts>`).

## Updating this repo

Sync runs on demand, never on a timer:

    agent/skills/omp-config/bin/omp-config-sync            # copy, sanitize, gate, diff, commit
    agent/skills/omp-config/bin/omp-config-sync --push     # commit, then push after confirming

The sync copies an allowlist out of the omp agent directory, strips literal
`apiKey:` and broker-token values, normalizes absolute home paths to `~/`, then
runs three gates before staging anything: a credential-shape grep, a
private-key grep, and `trufflehog filesystem`. Nothing is committed without a
diff review.

## Authoring extensions

The extension package and its house rules are documented in
[`agent/skills/omp-extensions/SKILL.md`](agent/skills/omp-extensions/SKILL.md).
README_EOF

REMOTE=$(git -C "$REPO" remote get-url origin 2>/dev/null || echo "")
# An ssh remote cannot be curled; derive the browsable https base from it.
BASE=$(printf '%s' "$REMOTE" | sed -E 's|^git@([^:]+):(.+)\.git$|https://\1/\2|; s|^ssh://git@([^/]+)/(.+)\.git$|https://\1/\2|; s|^https?://(.+)\.git$|https://\1|')
if [ -n "$BASE" ]; then
	sed -i "s|__REPO_BASE__|$BASE|g" "$REPO/README.md"
	sed -i "s|__REPO_CLONE__|$REMOTE|g" "$REPO/README.md"
fi

# ---------------------------------------------------------------- commit
cd "$REPO"
git init -q 2>/dev/null || true
[ -f .gitignore ] || printf '*.bak-*\n.DS_Store\n' > .gitignore
git add -A
echo
git diff --cached --stat | tail -20
if [ "$YES" -ne 1 ]; then
	read -r -p "commit these? [y/N] " ans
	[ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "aborted"; exit 0; }
fi
git commit -q -m "omp config sync $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "committed: $(git rev-parse --short HEAD)"

if [ "$PUSH" -eq 1 ]; then
	read -r -p "push to $(git remote get-url origin 2>/dev/null || echo '<no origin>')? [y/N] " ans
	[ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "committed, not pushed"; exit 0; }
	git push -q origin HEAD
	echo "pushed"
fi